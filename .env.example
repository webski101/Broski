# Required for judging — create at https://platform.armoriq.ai
ARMORIQ_API_KEY=ak_your_key_here

# Onboard these exact IDs on the ArmorIQ platform
USER_ID=broski-operator
AGENT_ID=d7681f20-2ac7-49db-a8ae-7e1ede22f14b
CONTEXT_ID=broski-hackathon

# production | development
ARMORIQ_ENV=production

# sdk (recommended) | local | proxy
ARMORIQ_SESSION_MODE=sdk

# When ArmorIQ proxy invoke fails after a signed-intent pass, execute the
# sandbox tool locally so the demo still shows ALLOW for mandate-covered calls.
# Set to 0/false to fail closed instead.
ARMORIQ_LOCAL_MCP_FALLBACK=1

# Optional ArmorIQ endpoint overrides (defaults are production)
# PROXY_ENDPOINT=https://proxy.armoriq.ai
# IAP_ENDPOINT=https://iap.armoriq.ai
# BACKEND_ENDPOINT=https://api.armoriq.ai

BROSKI_LLM=gpt-4o-mini
